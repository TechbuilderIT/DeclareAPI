<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DeclareAPI.Agent.CLI</RootNamespace>

    <!-- Tool Configuration -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>declareapi-agent</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>

    <!-- Package Metadata -->
    <PackageId>DeclareAPI.Agent</PackageId>
    <Version>0.1.0</Version>
    <Authors>Techbuilder</Authors>
    <Company>Techbuilder</Company>
    <Description>AI-powered agent for generating DeclareAPI configurations from ER diagrams. Uses Ollama for intelligent suggestions.</Description>
    <PackageTags>declareapi;api;generator;ai;ollama;mermaid;er-diagram;code-generation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TechbuilderIT/DeclareAPI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/TechbuilderIT/DeclareAPI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeclareAPI.Agent.Core\DeclareAPI.Agent.Core.csproj" />
    <ProjectReference Include="..\DeclareAPI.Agent.Parsers\DeclareAPI.Agent.Parsers.csproj" />
    <ProjectReference Include="..\DeclareAPI.Agent.AI\DeclareAPI.Agent.AI.csproj" />
    <ProjectReference Include="..\DeclareAPI.Agent.Generators\DeclareAPI.Agent.Generators.csproj" />
  </ItemGroup>

</Project>
